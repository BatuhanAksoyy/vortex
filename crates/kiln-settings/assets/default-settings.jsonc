// Kiln default settings. This file is the single source of default values.
// Override any key in your user settings file or in `.kiln/settings.json`.
{
  "theme": {
    // "system", "light" or "dark"
    "mode": "system",
    "light": "Kiln Light",
    "dark": "Kiln Dark"
  },
  "ui": {
    // Base size of the interface; every UI element scales with it.
    "font_size": 14,
    "font_family": ""
  },
  "editor": {
    "font_size": 13,
    // Empty means the platform monospace font.
    "font_family": "",
    "tab_size": 4,
    "line_numbers": true,
    "soft_wrap": false,
    "indent_guides": true,
    // The outline of the whole file beside the editor, to scroll by.
    "minimap": { "enabled": true }
  },
  "chat": {
    // Minutes a chat may stay idle before its agent's process stops, to
    // start again on the same conversation with the next message; 0 keeps
    // it running. A turn, subagent or background task keeps it awake.
    "sleep_after_minutes": 30
  },
  "files": {
    // Hidden from the file tree and quick open, in addition to .gitignore rules.
    "exclude": [".git", ".DS_Store"]
  },
  "git": {
    "commit": {
      // Regular expressions; matching lines are taken out of every commit
      // message, whoever wrote it.
      "strip": [
        "(?i)^co-authored-by:.*\\b(claude|codex|openai|anthropic)\\b",
        "(?i)generated with \\[?(claude code|codex)",
        "^🤖 Generated with"
      ],
      // The first line's most characters; 0 for no limit.
      "subject_max": 72,
      // The first line must read `type(scope): subject`.
      "conventional": false,
      // A commit the agent asks for waits for the user to approve or edit it.
      "review": true,
      // When the agent's work is committed: "agent" when it calls Kiln's
      // commit tool; "turn_end" also after a turn that changed files without
      // calling it, with a message the model below writes.
      "trigger": "agent",
      // Writes the message after a turn, on the chat's account.
      "model": "haiku"
    },
    "push": {
      // When Kiln pushes: "never"; "manual", with the Git page's Push;
      // "after_commit", also after each commit it makes of an agent's work;
      // "session_end", also when a chat that committed closes.
      "policy": "manual",
      // Pushed only once the user confirms, also by hand.
      "protected": ["main", "master"],
      // Where a branch that tracks none is pushed to.
      "remote": "origin"
    }
  }
}
