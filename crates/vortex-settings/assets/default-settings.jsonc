// Vortex default settings. This file is the single source of default values.
// Override any key in your user settings file or in `.vortex/settings.json`.
{
  "theme": {
    // "system", "light" or "dark"
    "mode": "system",
    "light": "Vortex Light",
    "dark": "Vortex Dark"
  },
  "ui": {
    // Base size of the interface; every UI element scales with it.
    "font_size": 14,
    "font_family": ""
  },
  "editor": {
    "font_size": 13,
    // Empty means the platform monospace font.
    "font_family": "",
    "tab_size": 4,
    "line_numbers": true,
    "soft_wrap": false,
    "indent_guides": true,
    // The outline of the whole file beside the editor, to scroll by.
    "minimap": { "enabled": true },
    // Blocks of code fold from the gutter.
    "gutter": { "folds": true },
    "typing": {
      // Typing an opening bracket or quote adds its closing one.
      "auto_close_brackets": true,
      // A new line keeps the indentation of the one before it.
      "auto_indent": true
    },
    // "none", or "all": spaces and tabs are drawn as faint dots and arrows.
    "show_whitespace": "none",
    // "half_page" past the last line, or "off" to stop there.
    "scroll_beyond_last_line": "half_page"
  },
  "chat": {
    // Minutes a chat may stay idle before its agent's process stops, to
    // start again on the same conversation with the next message; 0 keeps
    // it running. A turn, subagent or background task keeps it awake.
    "sleep_after_minutes": 30,
    // Where a chat's buttons and meters sit, in order: the title bar, and
    // the composer's strip from its left and before the send button. One
    // left out is hidden. The chat's pencil button changes these by drag.
    // Items: processes, account, usage, new_chat, attach, skills, hooks,
    // mode, model, effort, agents, tokens, cache, context.
    "toolbar": {
      "top": ["processes", "account", "usage", "new_chat"],
      "bottom_start": ["attach", "skills", "hooks", "mode", "model", "effort"],
      "bottom_end": ["agents", "tokens", "cache", "context"]
    },
    // "fuller" (the window nearer its limit), "session", "weekly" or "both".
    "usage_meter": "fuller",
    // Each harness's color as "#rrggbb"; empty keeps its own.
    "colors": { "claude": "", "codex": "" }
  },
  "files": {
    // Hidden from the file tree and quick open, in addition to .gitignore rules.
    "exclude": [".git", ".DS_Store"],
    // "off", or "after_delay": an edited file is saved once typing has
    // stopped for `auto_save_delay` milliseconds.
    "auto_save": "off",
    "auto_save_delay": 1000
  },
  "layout": {
    // Where the activity bar and the Files, Search and Changes panel sit:
    // "left" or "right" of the chats.
    "side_panel": "left",
    // Where the browser panel opens: "right", "left" or "bottom" of the chats.
    "browser": "right",
    // Where the file tree sits on the Files page: "left" or "right".
    "file_tree": "left",
    "activity_bar": true,
    "status_bar": true,
    // The title bar's buttons that show the side panel and the browser.
    "title_bar_buttons": true,
    // The activity bar's pages, top first; dragging one on the bar moves it.
    "activity_order": ["files", "search", "changes"]
  },
  "update": {
    // Look for a newer Vortex on GitHub at start and every few hours.
    "check": true
  },
  "git": {
    "commit": {
      // Regular expressions; matching lines are taken out of every commit
      // message, whoever wrote it.
      // Vortex commits a chat's work for it: a strip over the chat counts the
      // files it changed and commits them with a button, and "trigger" may
      // be "task_done". The agent's own commit tool works either way.
      "enabled": false,
      "strip": [
        "(?i)^co-authored-by:.*\\b(claude|codex|openai|anthropic)\\b",
        "(?i)generated with \\[?(claude code|codex)",
        "^🤖 Generated with"
      ],
      // The first line's most characters; 0 for no limit.
      "subject_max": 72,
      // The first line must read `type(scope): subject`.
      "conventional": false,
      // Told to whoever writes a message, the agent or the writer below,
      // such as "Write in English" or "Start with the ticket id".
      "instructions": [],
      // Regular expressions a message must match, each of them.
      "require": [],
      // Regular expressions a message must not match. Unlike `strip`, the
      // message goes back to be written again.
      "forbid": [],
      // A commit waits for the user to approve or edit it.
      "review": true,
      // When the agent's work is committed: "agent" when it calls Vortex's
      // commit tool or the user presses Commit; "task_done", with "enabled",
      // also once a turn ends with the work done, as the writer judges it.
      "trigger": "agent",
      // The agent and model that judge a turn and write its message.
      "writer": { "agent": "claude", "model": "haiku" }
    },
    "push": {
      // When Vortex pushes: "never"; "manual", with the Git page's Push;
      // "after_commit", also after each commit it makes of an agent's work;
      // "session_end", also when a chat that committed closes.
      "policy": "manual",
      // Pushed only once the user confirms, also by hand.
      "protected": ["main", "master"],
      // Where a branch that tracks none is pushed to.
      "remote": "origin"
    }
  }
}
