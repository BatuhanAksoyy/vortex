// Kiln default keybindings, matching VSCode's defaults for the same commands.
// `mac`, `linux` and `win` override `key` on that platform.
[
  { "key": "ctrl+p", "mac": "cmd+p", "command": "workbench.action.quickOpen" },
  { "key": "ctrl+shift+p", "mac": "cmd+shift+p", "command": "workbench.action.showCommands" },
  { "key": "f1", "command": "workbench.action.showCommands" },
  { "key": "ctrl+alt+i", "mac": "ctrl+cmd+i", "command": "workbench.action.chat.open" },
  { "key": "ctrl+shift+e", "mac": "cmd+shift+e", "command": "workbench.view.explorer" },
  { "key": "ctrl+shift+g", "command": "workbench.view.scm" },
  { "key": "ctrl+shift+f", "mac": "cmd+shift+f", "command": "workbench.action.findInFiles" },
  { "key": "ctrl+b", "mac": "cmd+b", "command": "workbench.action.toggleSidebarVisibility" },
  { "key": "ctrl+,", "mac": "cmd+,", "command": "workbench.action.openSettingsJson" },
  { "key": "ctrl+k ctrl+s", "mac": "cmd+k cmd+s", "command": "workbench.action.openGlobalKeybindingsFile" },
  { "key": "ctrl+k ctrl+o", "mac": "cmd+o", "command": "workbench.action.files.openFolder" },
  { "key": "ctrl+shift+n", "mac": "cmd+shift+n", "command": "workbench.action.newWindow" },
  { "key": "ctrl+s", "mac": "cmd+s", "command": "workbench.action.files.save" },
  { "key": "ctrl+w", "mac": "cmd+w", "command": "workbench.action.closeActiveEditor" },
  { "key": "ctrl+pagedown", "mac": "cmd+alt+right", "command": "workbench.action.nextEditor" },
  { "key": "ctrl+pageup", "mac": "cmd+alt+left", "command": "workbench.action.previousEditor" },
  { "key": "ctrl+=", "mac": "cmd+=", "command": "workbench.action.zoomIn" },
  { "key": "ctrl+-", "mac": "cmd+-", "command": "workbench.action.zoomOut" },
  { "key": "ctrl+numpad0", "mac": "cmd+numpad0", "command": "workbench.action.zoomReset" },
  { "key": "ctrl+q", "mac": "cmd+q", "command": "workbench.action.quit" }
]
